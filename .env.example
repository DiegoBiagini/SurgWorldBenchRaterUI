# Copy to .env and set RATER_PASSWORD.
#
#   cp .env.example .env
#   docker compose -f docker-compose.auth.yml up --build

RATER_USER=rater
RATER_PASSWORD=

# Host directory bind-mounted at /mnt/rater_filesystem in the container.
# Default is /mnt/rater_filesystem (same path on host and in the container).
# RATER_FILESYSTEM=/mnt/rater_filesystem
